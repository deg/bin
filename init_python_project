#!/bin/bash

# =========================
# Python Project Initializer
# =========================
# Features:
# - Project scaffolding with Poetry
# - Git repository setup
# - Pre-configured pyproject.toml for code style tools
# - GitHub Actions CI/CD pipeline
# - Sample test cases
# - Optional license file
# - Pre-commit hooks
# - Makefile for common tasks

# Check if 'gum' is installed, if not, install it
if ! command -v gum &> /dev/null; then
  echo "⚡ 'gum' is not installed. Installing now..."
  if command -v brew &> /dev/null; then
    brew install charmbracelet/tap/gum
  elif command -v apt-get &> /dev/null; then
    sudo apt-get update && sudo apt-get install -y gum
  elif command -v dnf &> /dev/null; then
    sudo dnf install -y gum
  else
    echo "❌ Could not detect a supported package manager (brew, apt, dnf). Please install 'gum' manually."
    exit 1
  fi
fi

# Prompt for project name if not supplied
if [ -z "$1" ]; then
  read -p "Enter project name: " project_name
else
  project_name=$1
fi

# Check if project directory already exists
if [ -d "$project_name" ]; then
  echo "❌ Directory '$project_name' already exists. Aborting."
  exit 1
fi

# Prompt to initialize a Git repository
init_git=$(gum choose "Yes" "No" --header="Do you want to initialize a Git repository?")

# Prompt to add a license
license_choice=$(gum choose "MIT" "Apache-2.0" "None" --header="Select a license type:")

# Create project directory
mkdir -p "$project_name"/tests
cd "$project_name" || exit

# =====================
# Poetry Project Setup
# =====================
poetry init --no-interaction --name "$project_name"
poetry add --dev pyright black isort flake8 pytest mypy coverage pre-commit

# =====================
# Pre-configured pyproject.toml
# =====================
cat <<EOL >> pyproject.toml

[tool.black]
line-length = 88
target-version = ["py310"]

[tool.isort]
profile = "black"

[tool.flake8]
max-line-length = 88
extend-ignore = ["E203"]

[tool.mypy]
strict = true

[tool.pytest]
minversion = "6.0"
addopts = "-ra -q"
testpaths = ["tests"]
EOL

# =====================
# Sample Python Files
# =====================
echo "def main():\n    print(\"Hello, World!\")" > main.py

# Sample Test Case
echo "def test_example():\n    assert 1 + 1 == 2" > tests/test_main.py

# README

echo "# $project_name" > README.md

# =====================
# .gitignore Generation
# =====================
cat <<EOL > .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/

# Poetry
poetry.lock
EOL

# =====================
# GitHub Actions CI/CD
# =====================
mkdir -p .github/workflows
cat <<EOL > .github/workflows/ci.yml
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-python@v4
        with:
          python-version: '3.10'
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install poetry
          poetry install
      - name: Run linters
        run: |
          poetry run black --check .
          poetry run isort --check-only .
          poetry run flake8 .
          poetry run mypy .
      - name: Run tests
        run: |
          poetry run pytest
EOL

# =====================
# License Generation
# =====================
if [ "$license_choice" = "MIT" ]; then
  cat <<EOL > LICENSE
MIT License

Copyright (c) $(date +%Y) $USER

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
...
EOL

elif [ "$license_choice" = "Apache-2.0" ]; then
  cat <<EOL > LICENSE
Apache License 2.0

Copyright (c) $(date +%Y) $USER

Licensed under the Apache License, Version 2.0 (the "License");
...
EOL
fi

# =====================
# Git Initialization (Optional)
# =====================
if [ "$init_git" = "Yes" ]; then
  git init
  git add .
  git commit -m "Initial commit"
fi

# =====================
# Pre-commit Hooks Setup
# =====================
cat <<EOL > .pre-commit-config.yaml
repos:
  - repo: https://github.com/psf/black
    rev: 25.1.0
    hooks:
      - id: black

  - repo: https://github.com/pre-commit/mirrors-isort
    rev: v6.0.0
    hooks:
      - id: isort

  - repo: https://github.com/pycqa/flake8
    rev: v7.1.1
    hooks:
      - id: flake8
EOL

poetry run pre-commit install

# =====================
# Makefile for Common Tasks
# =====================
cat <<EOL > Makefile
install:
	poetry install

format:
	poetry run black .
	poetry run isort .

lint:
	poetry run flake8 .
	poetry run mypy .

test:
	poetry run pytest

type-check:
	poetry run mypy .
EOL

# =====================
# Final Message
# =====================
echo "✅ Python project '$project_name' initialized successfully!"
