#!/bin/bash

# =========================
# Python Project Initializer
# =========================
# Features:
# - Project scaffolding with Poetry
# - Git repository setup
# - Pre-configured pyproject.toml for code style tools
# - GitHub Actions CI/CD pipeline
# - Sample test cases
# - Optional license file
# - Pre-commit hooks
# - Makefile for common tasks
# - Optional Docker setup
# - VS Code workspace configuration
# - Test coverage reporting

# Error Handling
trap 'echo "❌ Error occurred. Exiting."; exit 1' ERR

# Check if 'gum' is installed, if not, install it
if ! command -v gum &> /dev/null; then
  echo "⚡ 'gum' is not installed. Installing now..."
  if command -v brew &> /dev/null; then
    brew install charmbracelet/tap/gum
  elif command -v apt-get &> /dev/null; then
    sudo apt-get update && sudo apt-get install -y gum
  elif command -v dnf &> /dev/null; then
    sudo dnf install -y gum
  else
    echo "❌ Could not detect a supported package manager (brew, apt, dnf). Please install 'gum' manually."
    exit 1
  fi
fi

# Prompt for project name if not supplied
if [ -z "$1" ]; then
  read -p "Enter project name: " project_name
else
  project_name=$1
fi

# Check if project directory already exists
if [ -d "$project_name" ]; then
  echo "❌ Directory '$project_name' already exists. Aborting."
  exit 1
fi

# Prompt to select Python version
python_version=$(gum choose "3.12" "3.11" --header="Select Python version:")

# Prompt to initialize a Git repository
init_git=$(gum choose "Yes" "No" --header="Do you want to initialize a Git repository?")

# Prompt to add a license
license_choice=$(gum choose "MIT" "Apache-2.0" "None" --header="Select a license type:")

# Prompt to include Docker setup
docker_choice=$(gum choose "Yes" "No" --header="Do you want to include Docker support?")

# Create project directory
mkdir -p "$project_name"/tests
cd "$project_name" || exit

# Poetry Project Setup
poetry init --no-interaction --name "$project_name" --python="^$python_version"
poetry env use python$python_version
poetry add --dev pyright black isort flake8 pytest mypy coverage pre-commit

# Pre-configured pyproject.toml
cat <<EOL >> pyproject.toml

[tool.black]
line-length = 88
target-version = ["py${python_version//./}"]

[tool.isort]
profile = "black"

[tool.flake8]
max-line-length = 88
extend-ignore = ["E203"]

[tool.mypy]
strict = true

[tool.pytest]
minversion = "6.0"
addopts = "-ra -q --cov=."
testpaths = ["tests"]
EOL

# Sample Python Files
echo "def main():\n    print(\"Hello, World!\")" > main.py
echo "def test_example():\n    assert 1 + 1 == 2" > tests/test_main.py

echo "# $project_name" > README.md

# .gitignore Generation
cat <<EOL > .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/

# Poetry
poetry.lock
.coverage
htmlcov/
EOL

# Optional Docker Setup
if [ "$docker_choice" = "Yes" ]; then
  cat <<EOL > Dockerfile
FROM python:${python_version}
WORKDIR /app
COPY . .
RUN pip install poetry && poetry install
CMD ["poetry", "run", "python", "main.py"]
EOL

  cat <<EOL > docker-compose.yml
version: '3.8'
services:
  app:
    build: .
    volumes:
      - .:/app
    command: poetry run python main.py
EOL
fi

# GitHub Actions CI/CD
mkdir -p .github/workflows
cat <<EOL > .github/workflows/ci.yml
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-python@v4
        with:
          python-version: '$python_version'
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install poetry
          poetry install
      - name: Run linters
        run: |
          poetry run black --check .
          poetry run isort --check-only .
          poetry run flake8 .
          poetry run mypy .
      - name: Run tests with coverage
        run: |
          poetry run pytest --cov=.
      - name: Upload coverage report
        uses: codecov/codecov-action@v3
EOL

# License Generation
author_name=$(git config user.name)
author_email=$(git config user.email)
if [ "$license_choice" = "MIT" ]; then
  cat <<EOL > LICENSE
MIT License

Copyright (c) $(date +%Y) $author_name <$author_email>

Permission is hereby granted, free of charge, to any person obtaining a copy of this
software and associated documentation files (the "Software"), to deal in the Software
without restriction, including without limitation the rights to use, copy, modify,
merge, publish, distribute, sublicense, and/or sell copies of the Software, and to
permit persons to whom the Software is furnished to do so, subject to the following
conditions:

The above copyright notice and this permission notice shall be included in all copies or
substantial portions of the Software.

THE SOFTWARE IS PROVIDED “AS IS”, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED,
INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR
PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT
OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR
OTHER DEALINGS IN THE SOFTWARE.
EOL

elif [ "$license_choice" = "Apache-2.0" ]; then
  cat <<EOL > LICENSE
Apache License 2.0

Copyright (c) $(date +%Y) $author_name <$author_email>

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.
...
EOL
fi

# Git Initialization
if [ "$init_git" = "Yes" ]; then
  git init
  git add .
  git commit -m "Initial commit"
fi

# Pre-commit Hooks Setup
cat <<EOL > .pre-commit-config.yaml
repos:
  - repo: https://github.com/psf/black
    rev: 25.1.0
    hooks:
      - id: black
  - repo: https://github.com/pre-commit/mirrors-isort
    rev: v6.0.0
    hooks:
      - id: isort
  - repo: https://github.com/pycqa/flake8
    rev: v7.1.1
    hooks:
      - id: flake8
EOL

poetry run pre-commit install

# Makefile
cat <<EOL > Makefile
install:
	poetry install

format:
	poetry run black .
	poetry run isort .

lint:
	poetry run flake8 .
	poetry run mypy .

test:
	poetry run pytest

coverage:
	poetry run pytest --cov=.

type-check:
	poetry run mypy .
EOL

# Optional VS Code Workspace Settings
mkdir -p .vscode
cat <<EOL > .vscode/settings.json
{
  "python.pythonPath": ".venv/bin/python",
  "python.formatting.provider": "black",
  "python.linting.enabled": true,
  "python.linting.flake8Enabled": true,
  "python.linting.mypyEnabled": true,
  "python.testing.pytestEnabled": true
}
EOL

echo "✅ Python project '$project_name' initialized successfully!"
