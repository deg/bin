#!/usr/bin/env bash
set -euo pipefail

# vm — disposable Ubuntu VMs on top of multipass.
#
# The point of this wrapper is that multipass's defaults (1 CPU / 1G / 5G) are
# far too small to be useful, and its two most valuable features — cloud-init
# provisioning and --purge teardown — are the ones easiest to forget to type.

[[ -f "$HOME/.vmrc" ]] && source "$HOME/.vmrc"

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

VM_IMAGE="${VM_IMAGE:-26.04}"
VM_CPUS="${VM_CPUS:-4}"
VM_MEM="${VM_MEM:-8G}"
VM_DISK="${VM_DISK:-40G}"
VM_DEFAULT_NAME="${VM_DEFAULT_NAME:-scratch}"
VM_TIMEOUT="${VM_TIMEOUT:-600}"
VM_CLOUD_INIT="${VM_CLOUD_INIT:-$SELF_DIR/vm-cloud-init/dev.yaml}"
VM_SSH_KEY="${VM_SSH_KEY:-$HOME/.ssh/multipass_vm}"

# Host directories auto-mounted by `vm new`, as space-separated <src>:<target>
# pairs. A relative target lands under /home/ubuntu. Paths may not contain
# spaces. Set to "" to launch with nothing shared.
VM_MOUNTS="${VM_MOUNTS:-$HOME/Documents:host-documents}"

# What `vm bootstrap` seeds a VM with, to satisfy setup-new-machine.sh's own
# sanity check and let it clone over ssh. Deliberately ONE key, not all of
# ~/.ssh -- that directory holds AWS/Azure/GCP credentials with no business
# in a disposable VM.
VM_BOOTSTRAP_KEY="${VM_BOOTSTRAP_KEY:-$HOME/.ssh/id_rsa_github}"
VM_BOOTSTRAP_DIR="${VM_BOOTSTRAP_DIR:-$HOME/core-personal-files}"

# Space-separated instances `vm nuke` and `vm reset` refuse to touch without
# --force. Empty by default -- everything is disposable until you say otherwise.
# Name any long-lived VM here (best set in ~/.vmrc) to shield it.
VM_PROTECTED="${VM_PROTECTED:-}"

show_help() {
  cat <<'EOF'
vm — disposable Ubuntu VMs via multipass
========================================

Usage:
  vm <command> [args]

Lifecycle
---------
  new [name] [-i FILE] [-b]
      Create a VM, apply VM_MOUNTS, and shell into it. Refuses if <name>
      already exists, so it can never clobber a box you are still using.
      Provisioning comes from the cloud-init file; -i FILE uses a different
      one, --no-cloud-init skips it for a bare Ubuntu. -b/--bootstrap also
      seeds the box for setup-new-machine.sh (see `bootstrap`).

  reset [name]
      nuke + new under the same name -- the fastest route back to a known-clean
      box, and the reason this script exists. Everything inside the VM is lost;
      host directories you mounted are untouched.

  nuke [name] [--force]
      Permanently destroy the VM and its snapshots (delete --purge). Unlike a
      bare `multipass delete` there is no undo and the disk is freed at once.
      Refuses instances listed in VM_PROTECTED unless you pass --force.

  gc
      Free disk from instances sitting in the Deleted state after a bare
      `multipass delete`. Never touches running or stopped instances.

Daily use
---------
  sh|shell [name]
      Interactive shell in the VM as user 'ubuntu'. Tries multipass first, then
      falls back to plain ssh -- see "No route to host" below.

  run <name> <cmd...>
      Run one command in the VM and exit with its status, so it composes in
      scripts and pipelines. Arguments are re-quoted before they cross, so
      quotes and globs survive:  vm run box bash -c 'ls ~/*.log'

  ls
      Every instance with its state and IP, all snapshots, and how much room is
      left on the host disk.

  ip [name]
      The VM's IPv4 address alone, for scripting:  curl http://$(vm ip):8000/

  mount <name> <dir> [target]
      Share a host directory into the VM. Read-write, changes visible both ways
      immediately, and it survives stop/start. This -- not snapshots -- is how
      you keep work that matters: the files live on the host, so the VM stays
      disposable.
      [!] macOS withholds ~/Documents, ~/Desktop and ~/Downloads from the
      multipass daemon. Mounting those attaches successfully but the directory
      reads as EMPTY inside the VM, with no error. Granting Full Disk Access to
      /Library/Application Support/com.canonical.multipass/bin/multipassd is
      the likely fix.

Persistence
-----------
  snap <name> [label]
      Checkpoint the VM's whole disk under a name you choose. multipass can
      only snapshot a stopped instance, so this stops it, snapshots, and
      restarts it if it had been running.

  restore <name> <snap>
      Roll the VM back to a checkpoint, then restart it. DESTRUCTIVE: every
      change made since that snapshot is discarded, and it does not stop to
      ask. Snapshots capture installed system state; use mounts for files.

Bootstrapping a new-machine test
--------------------------------
  bootstrap [name]
      Put a VM in the state setup-new-machine.sh expects, doing by command
      what the new-machine flow does by hand: copy in VM_BOOTSTRAP_KEY, write
      a minimal ~/.ssh/config pointing github at it, and copy
      VM_BOOTSTRAP_DIR (core-personal-files, with its .git) into the VM. Then
      run the script yourself -- it is interactive and makes real changes, so
      it is deliberately never run for you.
      Only ONE ssh key travels, not all of ~/.ssh: that directory holds AWS,
      Azure and GCP credentials that have no business in a throwaway VM.
      core-personal-files is COPIED rather than mounted on purpose -- the
      script runs `git pull` and rewrites dotfiles in it, and a mount would
      aim all of that at your host checkout.

Other
-----
  gui
      Open Multipass.app, Canonical's point-and-click instance manager. It
      manages VMs -- it is NOT an Ubuntu desktop. These are headless server
      images booted with no display device at all.

  help
      This text.

Naming
------
  Commands taking [name] default to "scratch". Assume anything inside a VM is
  gone on the next reset; keep what matters on the host via mount, or freeze a
  known-good system state with snap.

Configuration (environment, or ~/.vmrc)
---------------------------------------
  VM_IMAGE=26.04     VM_CPUS=4       VM_MEM=8G      VM_DISK=40G
  VM_TIMEOUT=600     VM_DEFAULT_NAME=scratch
  VM_CLOUD_INIT=<path to cloud-init YAML>
  VM_SSH_KEY=~/.ssh/multipass_vm    (fallback key, see below)
  VM_PROTECTED=""       (space-separated names vm nuke/reset won't touch)
  VM_MOUNTS="$HOME/Documents:host-documents"
                        Space-separated <src>:<target> pairs mounted by
                        `vm new`. Relative targets land under /home/ubuntu.
  VM_BOOTSTRAP_KEY=~/.ssh/id_rsa_github
  VM_BOOTSTRAP_DIR=~/core-personal-files

  VM_TIMEOUT is generous because cloud-init runs apt on first boot; multipass's
  own 5-minute default is not enough and fails looking like a hang.

Note on 'No route to host'
--------------------------
  multipass's client cannot open SSH sessions on this machine: `multipass
  shell` and `multipass exec` fail this way for every instance, including ones
  created long before this script. The daemon's own SSH works (launching,
  provisioning, mounts and snapshots are all unaffected) and the VMs answer on
  port 22 from the host, so the fault is client-side, not network.

  `vm sh` and `vm run` therefore try multipass first and fall back to plain ssh
  with VM_SSH_KEY, whose public half `vm new` installs through cloud-init. That
  fallback only reaches instances created after the key was added -- for older
  ones, `vm reset <name>` rebuilds them with it in place.

Examples
--------
  vm new                          # 4-core / 8G / 40G Ubuntu 26.04 named "scratch"
  vm new ansible-test             # a second, differently-named box
  vm run scratch uname -a
  vm new newmachine -b          # clean box, seeded for setup-new-machine.sh
  vm mount scratch ~/Documents/degel/blogscraper   # but see [!] under mount
  vm snap scratch clean-base      # checkpoint before you break something
  vm restore scratch clean-base   # go back to it
  vm reset                        # burn it down and start over
  vm nuke ansible-test
EOF
}

die()  { echo "vm: $*" >&2; exit 1; }
warn() { echo "vm: [!] $*" >&2; }

need_multipass() {
  command -v multipass >/dev/null 2>&1 \
    || die "multipass not found. Install from https://multipass.run/"
}

exists() { multipass info "$1" >/dev/null 2>&1; }

is_protected() {
  local n="$1" p
  for p in $VM_PROTECTED; do [[ "$n" == "$p" ]] && return 0; done
  return 1
}

state_of() {
  multipass info "$1" --format csv 2>/dev/null | awk -F, 'NR==2 {print $2}'
}

# multipass's client SSH is broken on this host (see `vm help`). Try it anyway
# -- it is the supported path and may be fixed -- then fall back to plain ssh
# against the key cloud-init installed.
ssh_target() {
  local name="$1" ip
  ip="$(cmd_ip "$name")" || return 1
  [[ -n "$ip" ]] || return 1
  printf 'ubuntu@%s' "$ip"
}

ssh_opts() {
  printf '%s\n' -i "$VM_SSH_KEY" \
    -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
    -o LogLevel=ERROR -o ConnectTimeout=10
}

vm_connect() {
  local name="$1"
  multipass shell "$name" 2>/dev/null && return 0
  [[ -f "$VM_SSH_KEY" ]] || die "multipass shell failed and no fallback key at $VM_SSH_KEY"
  local target; target="$(ssh_target "$name")" \
    || die "multipass shell failed and '$name' has no IP yet"
  echo "(multipass shell failed; falling back to ssh $target)" >&2
  local opts; IFS=$'\n' read -r -d '' -a opts < <(ssh_opts && printf '\0')
  ssh "${opts[@]}" "$target"
}

vm_exec() {
  local name="$1"; shift
  multipass exec "$name" -- "$@" 2>/dev/null && return 0
  [[ -f "$VM_SSH_KEY" ]] || die "multipass exec failed and no fallback key at $VM_SSH_KEY"
  local target; target="$(ssh_target "$name")" \
    || die "multipass exec failed and '$name' has no IP"
  local opts; IFS=$'\n' read -r -d '' -a opts < <(ssh_opts && printf '\0')
  # ssh flattens argv into one string for the remote shell, so re-quote each
  # argument or anything with spaces/globs/quotes gets re-parsed remotely.
  local remote="" a
  for a in "$@"; do remote+="$(printf '%q ' "$a")"; done
  ssh "${opts[@]}" "$target" "$remote"
}

# multipass transfer rides the same broken client path as `multipass exec`, so
# try it and fall back to tar over the ssh connection we know works.
copy_into() {
  local name="$1" src="$2" dest="$3"
  multipass transfer -r "$src" "$name:$dest" 2>/dev/null && return 0
  local parent base
  parent="$(cd "$(dirname "$src")" && pwd)"
  base="$(basename "$src")"
  # --no-xattrs: macOS tar otherwise emits com.apple.provenance headers that
  # GNU tar in the VM complains about on every single file.
  COPYFILE_DISABLE=1 tar --no-xattrs -cf - -C "$parent" "$base" \
    | vm_exec "$name" tar -xf - -C "$dest"
}

apply_mounts() {
  local name="$1" spec src target
  [[ -n "$VM_MOUNTS" ]] || return 0
  for spec in $VM_MOUNTS; do
    src="${spec%%:*}"; target="${spec#*:}"
    src="${src/#\~/$HOME}"
    if [[ ! -d "$src" ]]; then
      warn "skipping mount, no such directory: $src"
      continue
    fi
    if multipass mount "$src" "$name:$target" >/dev/null 2>&1; then
      echo "Mounted $src -> $name:$target"
      # macOS hides ~/Documents, ~/Desktop and ~/Downloads from multipassd, in
      # which case the mount attaches but reads empty inside the VM. Say so now
      # rather than let it be discovered halfway through a build.
      if [[ -n "$(ls -A "$src" 2>/dev/null)" ]] \
         && [[ -z "$(vm_exec "$name" ls -A "$target" 2>/dev/null)" ]]; then
        warn "$target reads EMPTY in the VM although $src is not."
        warn "Fix: grant Full Disk Access to"
        warn "  /Library/Application Support/com.canonical.multipass/bin/multipassd"
      fi
    else
      warn "failed to mount $src"
    fi
  done
}

cmd_bootstrap() {
  local name="${1:-$VM_DEFAULT_NAME}"
  exists "$name" || die "no such instance: $name"
  [[ -f "$VM_BOOTSTRAP_KEY" ]] || die "no bootstrap key at $VM_BOOTSTRAP_KEY"
  [[ -d "$VM_BOOTSTRAP_DIR/.git" ]] || die "not a git checkout: $VM_BOOTSTRAP_DIR"

  local key; key="$(basename "$VM_BOOTSTRAP_KEY")"
  echo "Seeding '$name' the way a new machine gets seeded by hand..."

  vm_exec "$name" mkdir -p /home/ubuntu/.ssh
  vm_exec "$name" chmod 700 /home/ubuntu/.ssh
  # Shell snippets go through `bash -c` because vm_exec re-quotes each argument
  # -- a bare "cat > file" would arrive as a command name, not a redirect.
  vm_exec "$name" bash -c "cat > /home/ubuntu/.ssh/$key" < "$VM_BOOTSTRAP_KEY"
  vm_exec "$name" chmod 600 "/home/ubuntu/.ssh/$key"
  if [[ -f "$VM_BOOTSTRAP_KEY.pub" ]]; then
    vm_exec "$name" bash -c "cat > /home/ubuntu/.ssh/$key.pub" < "$VM_BOOTSTRAP_KEY.pub"
  fi

  # Minimal ssh config pointing github at that one key. The host's own
  # ~/.ssh/config names client infrastructure and is macOS-specific, so it
  # deliberately does not travel.
  vm_exec "$name" bash -c "printf 'Host github.com\n  HostName github.com\n  IdentityFile ~/.ssh/%s\n  StrictHostKeyChecking accept-new\n' '$key' > /home/ubuntu/.ssh/config"
  vm_exec "$name" chmod 600 /home/ubuntu/.ssh/config

  echo "Copying $(basename "$VM_BOOTSTRAP_DIR") ($(du -sh "$VM_BOOTSTRAP_DIR" | cut -f1))..."
  copy_into "$name" "$VM_BOOTSTRAP_DIR" /home/ubuntu

  echo
  echo "Seeded. Now run the setup by hand, inside the VM:"
  echo "    vm sh $name"
  # An encrypted key would otherwise prompt for its passphrase once per clone.
  if ! ssh-keygen -y -P "" -f "$VM_BOOTSTRAP_KEY" >/dev/null 2>&1; then
    echo "    eval \$(ssh-agent) && ssh-add ~/.ssh/$key   # $key has a passphrase"
  fi
  echo "    ./core-personal-files/setup-new-machine.sh"
}

cmd_new() {
  local name="" ci="$VM_CLOUD_INIT" boot=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -i|--cloud-init) ci="$2"; shift 2 ;;
      --no-cloud-init) ci=""; shift ;;
      -b|--bootstrap)  boot=1; shift ;;
      -*) die "unknown option for new: $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  name="${name:-$VM_DEFAULT_NAME}"

  exists "$name" && die "instance '$name' already exists. Use 'vm reset $name' or pick another name."

  local args=( launch "$VM_IMAGE" -n "$name"
               -c "$VM_CPUS" -m "$VM_MEM" -d "$VM_DISK"
               --timeout "$VM_TIMEOUT" )
  if [[ -n "$ci" ]]; then
    [[ -f "$ci" ]] || die "cloud-init file not found: $ci"
    args+=( --cloud-init "$ci" )
    echo "Launching '$name' ($VM_IMAGE, ${VM_CPUS}c/${VM_MEM}/${VM_DISK}) with $(basename "$ci")..."
  else
    echo "Launching '$name' ($VM_IMAGE, ${VM_CPUS}c/${VM_MEM}/${VM_DISK}), no provisioning..."
  fi
  echo "First launch of a new release downloads an image; later ones are cached."

  multipass "${args[@]}"
  echo
  apply_mounts "$name"
  [[ $boot -eq 1 ]] && cmd_bootstrap "$name"
  echo
  echo "Ready: $name at $(cmd_ip "$name")"
  echo "Reconnect any time with: vm sh $name"
  echo
  vm_connect "$name" || true
}

cmd_nuke() {
  local force=0 name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -*) die "unknown option for nuke: $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  name="${name:-$VM_DEFAULT_NAME}"

  exists "$name" || { echo "vm: no instance '$name' — nothing to do."; return 0; }

  if is_protected "$name" && [[ $force -eq 0 ]]; then
    die "'$name' is protected (VM_PROTECTED). Re-run with --force if you really mean it."
  fi

  echo "Destroying '$name' permanently..."
  multipass delete --purge "$name"
  echo "Gone."
}

cmd_reset() {
  local force=0 name="" passthru=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -i|--cloud-init) passthru+=( -i "$2" ); shift 2 ;;
      --no-cloud-init) passthru+=( --no-cloud-init ); shift ;;
      -b|--bootstrap)  passthru+=( --bootstrap ); shift ;;
      -*) die "unknown option for reset: $1" ;;
      *) name="$1"; shift ;;
    esac
  done
  name="${name:-$VM_DEFAULT_NAME}"

  if exists "$name"; then
    if is_protected "$name" && [[ $force -eq 0 ]]; then
      die "'$name' is protected (VM_PROTECTED). Re-run with --force if you really mean it."
    fi
    echo "Destroying existing '$name'..."
    multipass delete --purge "$name"
  fi
  cmd_new "$name" "${passthru[@]+"${passthru[@]}"}"
}

cmd_ls() {
  multipass list
  echo
  echo "Snapshots:"
  multipass list --snapshots 2>&1 | sed 's/^/  /'
  echo
  echo "Host disk:"
  df -h /System/Volumes/Data | awk 'NR==2 {printf "  %s free of %s\n", $4, $2}'
}

cmd_snap() {
  local name="${1:-}" label="${2:-}"
  [[ -n "$name" ]] || die "usage: vm snap <name> [label]"
  exists "$name" || die "no such instance: $name"

  local was; was="$(state_of "$name")"
  if [[ "$was" == "Running" ]]; then
    echo "Stopping '$name' (multipass requires a stopped instance to snapshot)..."
    multipass stop "$name"
  fi

  if [[ -n "$label" ]]; then
    multipass snapshot "$name" -n "$label"
  else
    multipass snapshot "$name"
  fi

  if [[ "$was" == "Running" ]]; then
    echo "Restarting '$name'..."
    multipass start "$name"
  fi
}

cmd_restore() {
  local name="${1:-}" snap="${2:-}"
  [[ -n "$name" && -n "$snap" ]] || die "usage: vm restore <name> <snapshot>   (see 'vm ls')"
  exists "$name" || die "no such instance: $name"

  echo "This DISCARDS the current state of '$name' and rolls back to '$snap'."
  local was; was="$(state_of "$name")"
  [[ "$was" == "Running" ]] && { echo "Stopping '$name'..."; multipass stop "$name"; }

  multipass restore --destructive "$name.$snap"

  if [[ "$was" == "Running" ]]; then
    echo "Restarting '$name'..."
    multipass start "$name"
  fi
}

cmd_mount() {
  local name="${1:-}" dir="${2:-}" target="${3:-}"
  [[ -n "$name" && -n "$dir" ]] || die "usage: vm mount <name> <host-dir> [target]"
  [[ -d "$dir" ]] || die "not a directory: $dir"
  exists "$name" || die "no such instance: $name"

  local abs; abs="$(cd "$dir" && pwd)"
  target="${target:-/home/ubuntu/$(basename "$abs")}"
  multipass mount "$abs" "$name:$target"
  echo "Mounted $abs -> $name:$target"
}

cmd_gc() {
  echo "Purging instances already marked deleted..."
  multipass purge
  echo
  cmd_ls
}

cmd_ip() {
  local name="${1:-$VM_DEFAULT_NAME}"
  exists "$name" || die "no such instance: $name"
  multipass info "$name" --format csv | awk -F, 'NR==2 {print $3}'
}

cmd_gui() {
  local app="/Library/Application Support/com.canonical.multipass/bin/Multipass.app"
  [[ -d "$app" ]] || die "Multipass.app not found (it ships with the Canonical .pkg, not the brew cask)."
  echo "Opening the multipass instance manager. Note: this manages VMs;"
  echo "it is not an Ubuntu desktop — the images are headless server images."
  open "$app"
}

need_multipass

[[ $# -eq 0 ]] && { show_help; exit 1; }

cmd="$1"; shift
case "$cmd" in
  new)            cmd_new "$@" ;;
  reset)          cmd_reset "$@" ;;
  nuke)           cmd_nuke "$@" ;;
  gc)             cmd_gc "$@" ;;
  sh|shell)       vm_connect "${1:-$VM_DEFAULT_NAME}" ;;
  run)            [[ $# -ge 2 ]] || die "usage: vm run <name> <cmd...>"
                  n="$1"; shift; vm_exec "$n" "$@" ;;
  ls|list)        cmd_ls ;;
  ip)             cmd_ip "$@" ;;
  mount)          cmd_mount "$@" ;;
  snap|snapshot)  cmd_snap "$@" ;;
  restore)        cmd_restore "$@" ;;
  bootstrap)      cmd_bootstrap "$@" ;;
  gui)            cmd_gui ;;
  -h|--help|help) show_help ;;
  *)              echo "vm: unknown command '$cmd'" >&2; echo >&2; show_help >&2; exit 1 ;;
esac
