#!/usr/bin/env bash
set -euo pipefail

# vm — disposable Ubuntu VMs on top of multipass.
#
# The point of this wrapper is that multipass's defaults (1 CPU / 1G / 5G) are
# far too small to be useful, and its two most valuable features — cloud-init
# provisioning and --purge teardown — are the ones easiest to forget to type.

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Precedence: environment > ~/.vmrc > the defaults below. The environment has
# to be snapshotted first, because .vmrc assigns plainly -- without this,
# `VM_CPUS=8 vm new` would be silently overridden by the config file, and a
# VM_PROTECTED passed for one command would not apply at all.
_vm_env="$(export -p | grep '^declare -x VM_' || true)"
if [[ -f "$HOME/.vmrc" ]]; then
  # shellcheck source=/dev/null  # optional user config, absent by default
  source "$HOME/.vmrc"
fi
if [[ -n "$_vm_env" ]]; then eval "$_vm_env"; fi
unset _vm_env

VM_IMAGE="${VM_IMAGE:-26.04}"
VM_CPUS="${VM_CPUS:-4}"
VM_MEM="${VM_MEM:-8G}"
VM_DISK="${VM_DISK:-40G}"
VM_DEFAULT_NAME="${VM_DEFAULT_NAME:-scratch}"
VM_TIMEOUT="${VM_TIMEOUT:-600}"
VM_CLOUD_INIT="${VM_CLOUD_INIT:-$SELF_DIR/vm-cloud-init/dev.yaml}"
VM_SSH_KEY="${VM_SSH_KEY:-$HOME/.ssh/multipass_vm}"

# Host directories auto-mounted by `vm new`, as space-separated <src>:<target>
# pairs. A relative target lands under /home/ubuntu. Paths may not contain
# spaces. Set to "" to launch with nothing shared.
VM_MOUNTS="${VM_MOUNTS:-$HOME/Documents:host-documents}"

# What `vm bootstrap` seeds a VM with, to satisfy setup-new-machine.sh's own
# sanity check and let it clone over ssh. Deliberately ONE key, not all of
# ~/.ssh -- that directory holds AWS/Azure/GCP credentials with no business
# in a disposable VM.
VM_BOOTSTRAP_KEY="${VM_BOOTSTRAP_KEY:-$HOME/.ssh/id_rsa_github}"
VM_BOOTSTRAP_DIR="${VM_BOOTSTRAP_DIR:-$HOME/core-personal-files}"

# Space-separated instances `vm nuke` and `vm reset` refuse to touch without
# --force. Empty by default -- everything is disposable until you say otherwise.
# Name any long-lived VM here (best set in ~/.vmrc) to shield it.
VM_PROTECTED="${VM_PROTECTED:-}"

show_help() {
  cat <<'EOF'
vm — disposable Ubuntu VMs via multipass
========================================

Usage:
  vm <command> [args]

Lifecycle
---------
  new [name] [-i FILE] [-b]
      Create a VM, apply VM_MOUNTS, and shell into it. Refuses if <name>
      already exists, so it can never clobber a box you are still using.
      Provisioning comes from the cloud-init file; -i FILE uses a different
      one, --no-cloud-init skips it for a bare Ubuntu. -b/--bootstrap also
      seeds the box for setup-new-machine.sh (see `bootstrap`).

  reset [name]
      nuke + new under the same name -- the fastest route back to a known-clean
      box, and the reason this script exists. Everything inside the VM is lost;
      host directories you mounted are untouched.

  nuke [name] [--force]
      Permanently destroy the VM and its snapshots (delete --purge). Unlike a
      bare `multipass delete` there is no undo and the disk is freed at once.
      Refuses instances listed in VM_PROTECTED unless you pass --force.

  gc
      Free disk from instances sitting in the Deleted state after a bare
      `multipass delete`. Never touches running or stopped instances.

  recover [name]
      Undo a plain `multipass delete` -- brings a Deleted instance back intact.
      Powerless against `vm nuke` and `vm gc`, which purge.

Power
-----
  stop [name] | start [name] | restart [name]
      Shut the VM down / boot it / both. Stopping preserves the disk; it is
      leaving the shell that costs nothing, not this. All three take --all.

  suspend [name]
      Freeze the VM's memory to disk and release its CPU and RAM. Resumes with
      `start` faster than a stopped VM boots, and keeps running processes.

Daily use
---------
  sh|shell [name]
      Interactive shell in the VM as user 'ubuntu'. Tries multipass first, then
      falls back to plain ssh -- see "No route to host" below.

  run <name> <cmd...>
      Run one command in the VM and exit with its status, so it composes in
      scripts and pipelines. Arguments are re-quoted before they cross, so
      quotes and globs survive:  vm run box bash -c 'ls ~/*.log'

  ls
      Every instance with its state and IP, all snapshots, and how much room is
      left on the host disk.

  ip [name]
      The VM's IPv4 address alone, for scripting:  curl http://$(vm ip):8000/

  mount <name> <dir> [target]
      Share a host directory into the VM. Read-write, changes visible both ways
      immediately, and it survives stop/start. This -- not snapshots -- is how
      you keep work that matters: the files live on the host, so the VM stays
      disposable.
      [!] macOS withholds ~/Documents, ~/Desktop and ~/Downloads from the
      multipass daemon. Mounting those attaches successfully but the directory
      reads as EMPTY inside the VM, with no error. Granting Full Disk Access to
      /Library/Application Support/com.canonical.multipass/bin/multipassd is
      the likely fix.

  umount|unmount <name> [target]
      Detach a mount. With no target, detaches every mount on that instance.
      The host directory itself is untouched.

  push <name> <host-path> [vm-dest]
  pull <name> <vm-path> [host-dest]
      Copy files in and out. `multipass transfer` rides the same broken client
      path as `exec` here, so these fall back to tar over ssh. Defaults are
      /home/ubuntu going in, the current directory coming out.

  clone <source> [new-name]
      Duplicate an instance, disk and all -- provision one box the slow way,
      then stamp out copies. multipass can only clone a stopped instance, so
      this stops the source, clones, and restarts it if it had been running.

Persistence
-----------
  snap <name> [label]
      Checkpoint the VM's whole disk under a name you choose. multipass can
      only snapshot a stopped instance, so this stops it, snapshots, and
      restarts it if it had been running.

  restore <name> <snap>
      Roll the VM back to a checkpoint. DESTRUCTIVE: every change made since
      that snapshot is discarded, and it does not stop to ask. A VM that was
      running is restarted afterwards; one that was already stopped stays
      stopped. Snapshots capture installed system state; use mounts for files.

Bootstrapping a new-machine test
--------------------------------
  bootstrap [name]
      Put a VM in the state setup-new-machine.sh expects, doing by command
      what the new-machine flow does by hand: copy in VM_BOOTSTRAP_KEY, write
      a minimal ~/.ssh/config pointing github at it, and copy
      VM_BOOTSTRAP_DIR (core-personal-files, with its .git) into the VM. Then
      run the script yourself -- it is interactive and makes real changes, so
      it is deliberately never run for you.
      Only ONE ssh key travels, not all of ~/.ssh: that directory holds AWS,
      Azure and GCP credentials that have no business in a throwaway VM.
      core-personal-files is COPIED rather than mounted on purpose -- the
      script runs `git pull` and rewrites dotfiles in it, and a mount would
      aim all of that at your host checkout.

Other
-----
  gui
      Open Multipass.app, Canonical's point-and-click instance manager. It
      manages VMs -- it is NOT an Ubuntu desktop. These are headless server
      images booted with no display device at all.

  help
      This text.

Naming
------
  Commands taking [name] default to "scratch". Assume anything inside a VM is
  gone on the next reset; keep what matters on the host via mount, or freeze a
  known-good system state with snap.

Configuration (environment, or ~/.vmrc)
---------------------------------------
  VM_IMAGE=26.04     VM_CPUS=4       VM_MEM=8G      VM_DISK=40G
  VM_TIMEOUT=600     VM_DEFAULT_NAME=scratch
  VM_CLOUD_INIT=<path to cloud-init YAML>
  VM_SSH_KEY=~/.ssh/multipass_vm    (fallback key, see below)
  VM_PROTECTED=""       Space-separated names vm nuke/reset refuse to touch.
                        Entries are glob patterns, so "prod-*" covers a family.
  VM_MOUNTS="$HOME/Documents:host-documents"
                        Space-separated <src>:<target> pairs mounted by
                        `vm new`. Relative targets land under /home/ubuntu.
  VM_BOOTSTRAP_KEY=~/.ssh/id_rsa_github
  VM_BOOTSTRAP_DIR=~/core-personal-files

  VM_TIMEOUT is generous because cloud-init runs apt on first boot; multipass's
  own 5-minute default is not enough and fails looking like a hang.

Note on 'No route to host'
--------------------------
  multipass's client cannot open SSH sessions on this machine: `multipass
  shell` and `multipass exec` fail this way for every instance, including ones
  created long before this script. The daemon's own SSH works (launching,
  provisioning, mounts and snapshots are all unaffected) and the VMs answer on
  port 22 from the host, so the fault is client-side, not network.

  `vm sh` and `vm run` therefore try multipass first and fall back to plain ssh
  with VM_SSH_KEY, whose public half `vm new` installs through cloud-init. That
  fallback only reaches instances created after the key was added -- for older
  ones, `vm reset <name>` rebuilds them with it in place.

Examples
--------
  vm new                          # 4-core / 8G / 40G Ubuntu 26.04 named "scratch"
  vm new ansible-test             # a second, differently-named box
  vm run scratch uname -a
  vm new newmachine -b          # clean box, seeded for setup-new-machine.sh
  vm mount scratch ~/Documents/degel/blogscraper   # but see [!] under mount
  vm snap scratch clean-base      # checkpoint before you break something
  vm restore scratch clean-base   # go back to it
  vm reset                        # burn it down and start over
  vm nuke ansible-test
EOF
}

die()  { echo "vm: $*" >&2; exit 1; }
warn() { echo "vm: [!] $*" >&2; }

# Run a step that must succeed, aborting with a clear message if it does not.
#
# Needed because errexit is suppressed throughout a function invoked from an
# `if` condition, an `&&`, or an `||` -- which is how these commands get called.
# A step that merely returns nonzero would otherwise sail past unnoticed, so
# the check has to be on the step itself rather than on the caller.
must() { "$@" || die "step failed: $*"; }

need_multipass() {
  command -v multipass >/dev/null 2>&1 \
    || die "multipass not found. Install from https://multipass.run/"
}

exists() { multipass info "$1" >/dev/null 2>&1; }

is_protected() {
  local n="$1" p
  local -a protected=()
  # `read -a` splits on whitespace WITHOUT globbing. A bare `for p in
  # $VM_PROTECTED` also glob-expands, so VM_PROTECTED="scratch*" would expand
  # against the working directory and quietly protect nothing at all -- a
  # destructive guard failing open.
  if [[ -n "$VM_PROTECTED" ]]; then read -r -a protected <<<"$VM_PROTECTED"; fi
  local i
  for (( i = 0; i < ${#protected[@]}; i++ )); do
    p="${protected[i]}"
    # Unquoted on the right so entries work as patterns: "prod-*" shields every
    # prod box. Quoting it would compare literally, and VM_PROTECTED="scratch*"
    # would then silently protect nothing -- a destructive guard failing open,
    # which is the one way this must never fail.
    # shellcheck disable=SC2053  # glob matching is the point
    [[ "$n" == $p ]] && return 0
  done
  return 1
}

# Refuse destructive work on a name listed in VM_PROTECTED. Callers check this
# BEFORE asking whether the instance exists: protection is a property of the
# name, so it should hold whether or not the instance happens to be there right
# now -- which also means the guard can be verified without a real VM at risk.
guard_protected() {
  local name="$1" force="$2"
  if is_protected "$name" && [[ $force -eq 0 ]]; then
    die "'$name' is protected (VM_PROTECTED). Re-run with --force if you really mean it."
  fi
}

state_of() {
  multipass info "$1" --format csv 2>/dev/null | awk -F, 'NR==2 {print $2}'
}

# --- Reaching into an instance ---------------------------------------------
#
# multipass's own client cannot open SSH sessions on some hosts (see the "No
# route to host" note in `vm help`), so every way in falls back to plain ssh
# with VM_SSH_KEY.
#
# Which path to use is probed ONCE per run, deliberately, rather than inferred
# from each call's exit status. "multipass exec failed" and "the remote command
# exited nonzero" are indistinguishable by exit status alone, so retrying on
# nonzero would run a working command a second time -- and re-read a stdin that
# the first attempt had already consumed.

SSH_OPTS=( -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
           -o LogLevel=ERROR -o ConnectTimeout=10 )

_client_usable=""

client_usable() {
  if [[ -z "$_client_usable" ]]; then
    # </dev/null: the probe must not read the caller's stdin. copy_into pipes a
    # tar stream through vm_exec, and a probe that buffered any of it would
    # truncate the archive with no visible error.
    if multipass exec "$1" -- true >/dev/null 2>&1 </dev/null; then
      _client_usable=yes
    else
      _client_usable=no
      echo "(multipass client cannot open sessions here; using ssh)" >&2
    fi
  fi
  [[ "$_client_usable" == yes ]]
}

# Echoes ubuntu@<ip> for the ssh fallback, or dies. Callers assign it on its
# own line so that a die() inside this subshell still trips errexit.
fallback_target() {
  [[ -f "$VM_SSH_KEY" ]] || die "no fallback ssh key at $VM_SSH_KEY"
  # cmd_ip already reports a missing instance; exit rather than say it twice.
  local ip; ip="$(cmd_ip "$1")" || exit 1
  [[ -n "$ip" ]] || die "'$1' has no IP yet"
  printf 'ubuntu@%s' "$ip"
}

vm_connect() {
  local name="$1"
  if client_usable "$name"; then
    multipass shell "$name"
    return
  fi
  # fallback_target's die() only exits the command substitution, so an empty
  # result must be caught here -- otherwise ssh gets an empty hostname and
  # quietly tries the local machine instead.
  local target; target="$(fallback_target "$name")"
  [[ -n "$target" ]] || die "cannot determine an ssh target for '$name'"
  # shellcheck disable=SC2029  # no remote command here; $target is the host
  ssh -i "$VM_SSH_KEY" "${SSH_OPTS[@]}" "$target"
}

vm_exec() {
  local name="$1"; shift
  if client_usable "$name"; then
    multipass exec "$name" -- "$@"
    return
  fi
  # fallback_target's die() only exits the command substitution, so an empty
  # result must be caught here -- otherwise ssh gets an empty hostname and
  # quietly tries the local machine instead.
  local target; target="$(fallback_target "$name")"
  [[ -n "$target" ]] || die "cannot determine an ssh target for '$name'"
  # ssh flattens argv into one string for the remote shell, so re-quote each
  # argument or anything with spaces, globs or quotes gets re-parsed remotely.
  local remote="" a
  for a in "$@"; do remote+="$(printf '%q ' "$a")"; done
  # shellcheck disable=SC2029  # $remote is pre-quoted on purpose, client-side
  ssh -i "$VM_SSH_KEY" "${SSH_OPTS[@]}" "$target" "$remote"
}

# multipass transfer rides the same broken client path as `multipass exec`, so
# try it and fall back to tar over the ssh connection we know works.
copy_into() {
  local name="$1" src="$2" dest="$3"
  multipass transfer -r "$src" "$name:$dest" 2>/dev/null && return 0
  local parent base
  parent="$(cd "$(dirname "$src")" && pwd)"
  base="$(basename "$src")"
  # --no-xattrs: macOS tar otherwise emits com.apple.provenance headers that
  # GNU tar in the VM complains about on every single file.
  COPYFILE_DISABLE=1 tar --no-xattrs -cf - -C "$parent" "$base" \
    | vm_exec "$name" tar -xf - -C "$dest"
}

apply_mounts() {
  local name="$1" spec src target
  local -a specs=()
  [[ -n "$VM_MOUNTS" ]] || return 0
  # Split without globbing, for the same reason as is_protected().
  read -r -a specs <<<"$VM_MOUNTS"
  for spec in ${specs[@]+"${specs[@]}"}; do
    src="${spec%%:*}"; target="${spec#*:}"
    src="${src/#\~/$HOME}"
    if [[ ! -d "$src" ]]; then
      warn "skipping mount, no such directory: $src"
      continue
    fi
    if ! multipass mount "$src" "$name:$target" >/dev/null 2>&1; then
      warn "failed to mount $src"
      continue
    fi
    echo "Mounted $src -> $name:$target"

    # macOS hides ~/Documents, ~/Desktop and ~/Downloads from multipassd, in
    # which case the mount attaches but reads empty inside the VM. Warn now
    # rather than let it be discovered halfway through a build.
    #
    # Probe reachability first: without it, an unreachable VM yields an empty
    # string here too, and every mount would be blamed on Full Disk Access when
    # the real fault is that we cannot get into the VM at all.
    if ! vm_exec "$name" true >/dev/null 2>&1 </dev/null; then
      warn "cannot reach '$name' to check whether $target is readable"
    elif [[ -n "$(ls -A "$src" 2>/dev/null)" ]] \
         && [[ -z "$(vm_exec "$name" ls -A "$target" 2>/dev/null </dev/null)" ]]; then
      warn "$target reads EMPTY in the VM although $src is not."
      warn "Fix: grant Full Disk Access to"
      warn "  /Library/Application Support/com.canonical.multipass/bin/multipassd"
    fi
  done
}

cmd_bootstrap() {
  local name="${1:-$VM_DEFAULT_NAME}"
  exists "$name" || die "no such instance: $name"
  [[ -f "$VM_BOOTSTRAP_KEY" ]] || die "no bootstrap key at $VM_BOOTSTRAP_KEY"
  [[ -d "$VM_BOOTSTRAP_DIR/.git" ]] || die "not a git checkout: $VM_BOOTSTRAP_DIR"

  local key; key="$(basename "$VM_BOOTSTRAP_KEY")"
  echo "Seeding '$name' the way a new machine gets seeded by hand..."

  # Every step is wrapped in must(): see its comment. A half-seeded VM that
  # reports success is the worst outcome here, because the failure only shows
  # up much later as an inexplicable error from setup-new-machine.sh.
  must vm_exec "$name" mkdir -p /home/ubuntu/.ssh
  must vm_exec "$name" chmod 700 /home/ubuntu/.ssh
  # Shell snippets go through `bash -c` because vm_exec re-quotes each argument
  # -- a bare "cat > file" would arrive as a command name, not a redirect.
  must vm_exec "$name" bash -c "cat > /home/ubuntu/.ssh/$key" < "$VM_BOOTSTRAP_KEY"
  must vm_exec "$name" chmod 600 "/home/ubuntu/.ssh/$key"
  if [[ -f "$VM_BOOTSTRAP_KEY.pub" ]]; then
    must vm_exec "$name" bash -c "cat > /home/ubuntu/.ssh/$key.pub" < "$VM_BOOTSTRAP_KEY.pub"
  fi

  # Minimal ssh config pointing github at that one key. The host's own
  # ~/.ssh/config names client infrastructure and is macOS-specific, so it
  # deliberately does not travel.
  must vm_exec "$name" bash -c "printf 'Host github.com\n  HostName github.com\n  IdentityFile ~/.ssh/%s\n  StrictHostKeyChecking accept-new\n' '$key' > /home/ubuntu/.ssh/config"
  must vm_exec "$name" chmod 600 /home/ubuntu/.ssh/config

  echo "Copying $(basename "$VM_BOOTSTRAP_DIR") ($(du -sh "$VM_BOOTSTRAP_DIR" | cut -f1))..."
  must copy_into "$name" "$VM_BOOTSTRAP_DIR" /home/ubuntu

  echo
  echo "Seeded. Now run the setup by hand, inside the VM:"
  echo "    vm sh $name"
  # An encrypted key would otherwise prompt for its passphrase once per clone.
  if ! ssh-keygen -y -P "" -f "$VM_BOOTSTRAP_KEY" >/dev/null 2>&1; then
    echo "    eval \$(ssh-agent) && ssh-add ~/.ssh/$key   # $key has a passphrase"
  fi
  echo "    ./core-personal-files/setup-new-machine.sh"
}

cmd_new() {
  local name="" ci="$VM_CLOUD_INIT" boot=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -i|--cloud-init) [[ $# -ge 2 ]] || die "usage: vm new [name] [-i FILE] [-b]"
                       ci="$2"; shift 2 ;;
      --no-cloud-init) ci=""; shift ;;
      -b|--bootstrap)  boot=1; shift ;;
      -*) die "unknown option for new: $1" ;;
      # Refuse a second name rather than silently keeping the last one.
      *) [[ -z "$name" ]] || die "too many arguments: '$name' and '$1'"
         name="$1"; shift ;;
    esac
  done
  name="${name:-$VM_DEFAULT_NAME}"

  exists "$name" && die "instance '$name' already exists. Use 'vm reset $name' or pick another name."

  local args=( launch "$VM_IMAGE" -n "$name"
               -c "$VM_CPUS" -m "$VM_MEM" -d "$VM_DISK"
               --timeout "$VM_TIMEOUT" )
  if [[ -n "$ci" ]]; then
    [[ -f "$ci" ]] || die "cloud-init file not found: $ci"
    args+=( --cloud-init "$ci" )
    echo "Launching '$name' ($VM_IMAGE, ${VM_CPUS}c/${VM_MEM}/${VM_DISK}) with $(basename "$ci")..."
  else
    echo "Launching '$name' ($VM_IMAGE, ${VM_CPUS}c/${VM_MEM}/${VM_DISK}), no provisioning..."
  fi
  echo "First launch of a new release downloads an image; later ones are cached."

  multipass "${args[@]}"
  echo
  apply_mounts "$name"
  # cmd_bootstrap guards its own steps with must(); wrapping the call in
  # `|| die` here would be worse than useless, since putting the call in an
  # || list suppresses errexit for the whole of its body.
  if [[ $boot -eq 1 ]]; then cmd_bootstrap "$name"; fi
  echo
  echo "Ready: $name at $(cmd_ip "$name")"
  echo "Reconnect any time with: vm sh $name"
  echo
  vm_connect "$name" || true
}

cmd_nuke() {
  local force=0 name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -*) die "unknown option for nuke: $1" ;;
      # `multipass delete` takes several names, so `vm nuke old keeper` is a
      # natural thing to type. Keeping only the last would purge the wrong VM.
      *) [[ -z "$name" ]] || die "too many arguments: '$name' and '$1' (nuke takes one instance)"
         name="$1"; shift ;;
    esac
  done
  name="${name:-$VM_DEFAULT_NAME}"

  guard_protected "$name" "$force"
  exists "$name" || { echo "vm: no instance '$name' — nothing to do."; return 0; }

  echo "Destroying '$name' permanently..."
  multipass delete --purge "$name"
  echo "Gone."
}

cmd_reset() {
  local force=0 name="" boot=0 ci="$VM_CLOUD_INIT" passthru=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--force) force=1; shift ;;
      -i|--cloud-init) [[ $# -ge 2 ]] || die "usage: vm reset [name] [-i FILE] [-b]"
                       ci="$2"; passthru+=( -i "$2" ); shift 2 ;;
      --no-cloud-init) ci=""; passthru+=( --no-cloud-init ); shift ;;
      -b|--bootstrap)  boot=1; passthru+=( --bootstrap ); shift ;;
      -*) die "unknown option for reset: $1" ;;
      *) [[ -z "$name" ]] || die "too many arguments: '$name' and '$1' (reset takes one instance)"
         name="$1"; shift ;;
    esac
  done
  name="${name:-$VM_DEFAULT_NAME}"

  guard_protected "$name" "$force"

  # Validate everything the rebuild will need BEFORE destroying anything.
  # --purge is exactly what `vm recover` cannot undo, so a stale VM_CLOUD_INIT
  # must not cost a live VM that then cannot be recreated.
  [[ -z "$ci" || -f "$ci" ]] || die "cloud-init file not found: $ci (refusing to destroy '$name')"
  if [[ $boot -eq 1 ]]; then
    [[ -f "$VM_BOOTSTRAP_KEY" ]] \
      || die "no bootstrap key at $VM_BOOTSTRAP_KEY (refusing to destroy '$name')"
    [[ -d "$VM_BOOTSTRAP_DIR/.git" ]] \
      || die "not a git checkout: $VM_BOOTSTRAP_DIR (refusing to destroy '$name')"
  fi

  if exists "$name"; then
    echo "Destroying existing '$name'..."
    multipass delete --purge "$name"
  fi
  cmd_new "$name" "${passthru[@]+"${passthru[@]}"}"
}

cmd_ls() {
  multipass list
  echo
  echo "Snapshots:"
  multipass list --snapshots 2>&1 | sed 's/^/  /'
  echo
  echo "Host disk:"
  df -h /System/Volumes/Data | awk 'NR==2 {printf "  %s free of %s\n", $4, $2}'
}

cmd_snap() {
  local name="${1:-}" label="${2:-}"
  [[ -n "$name" ]] || die "usage: vm snap <name> [label]"
  exists "$name" || die "no such instance: $name"

  local was; was="$(state_of "$name")"
  if [[ "$was" == "Running" ]]; then
    echo "Stopping '$name' (multipass requires a stopped instance to snapshot)..."
    multipass stop "$name"
  fi

  # On failure the VM must not be left stopped: it was running a moment ago,
  # and a duplicate snapshot name is an easy mistake to make.
  local rc=0
  if [[ -n "$label" ]]; then
    multipass snapshot "$name" -n "$label" || rc=$?
  else
    multipass snapshot "$name" || rc=$?
  fi

  if [[ "$was" == "Running" ]]; then
    echo "Restarting '$name'..."
    multipass start "$name"
  fi
  [[ $rc -eq 0 ]] || die "snapshot of '$name' failed"
}

cmd_restore() {
  local name="${1:-}" snap="${2:-}"
  [[ -n "$name" && -n "$snap" ]] || die "usage: vm restore <name> <snapshot>   (see 'vm ls')"
  exists "$name" || die "no such instance: $name"

  echo "This DISCARDS the current state of '$name' and rolls back to '$snap'."
  local was; was="$(state_of "$name")"
  [[ "$was" == "Running" ]] && { echo "Stopping '$name'..."; multipass stop "$name"; }

  # As in cmd_snap: a mistyped snapshot name must not leave the VM stopped.
  local rc=0
  multipass restore --destructive "$name.$snap" || rc=$?

  if [[ "$was" == "Running" ]]; then
    echo "Restarting '$name'..."
    multipass start "$name"
  fi
  [[ $rc -eq 0 ]] || die "restore of '$name.$snap' failed (see 'vm ls' for snapshot names)"
}

cmd_mount() {
  local name="${1:-}" dir="${2:-}" target="${3:-}"
  [[ -n "$name" && -n "$dir" ]] || die "usage: vm mount <name> <host-dir> [target]"
  [[ -d "$dir" ]] || die "not a directory: $dir"
  exists "$name" || die "no such instance: $name"

  local abs; abs="$(cd "$dir" && pwd)"
  target="${target:-/home/ubuntu/$(basename "$abs")}"
  multipass mount "$abs" "$name:$target"
  echo "Mounted $abs -> $name:$target"
}

cmd_gc() {
  echo "Purging instances already marked deleted..."
  multipass purge
  echo
  cmd_ls
}

# Pass through to multipass, defaulting to the usual instance when given no
# arguments, but leaving flags like --all alone.
passthru() {
  local sub="$1"; shift
  if [[ $# -eq 0 ]]; then
    multipass "$sub" "$VM_DEFAULT_NAME"
  else
    multipass "$sub" "$@"
  fi
}

# Deliberately NOT `multipass restart`, which is unusable on this machine: it
# reboots the guest from inside, then waits for an SSH check that never
# completes, stranding the instance in "Restarting" forever even though the VM
# is up. Stop-then-start touches none of that and takes about 20 seconds.
cmd_restart() {
  # --all needs its own path: state_of reads a single CSV row, so asking it
  # about "--all" would silently report only the first instance's state and
  # skip the stop for everything else.
  if [[ "${1:-}" == "--all" ]]; then
    multipass stop --force --all
    multipass start --all
    return
  fi
  local name="${1:-$VM_DEFAULT_NAME}"
  exists "$name" || die "no such instance: $name"
  [[ "$(state_of "$name")" == "Stopped" ]] || multipass stop --force "$name"
  multipass start "$name"
}

cmd_umount() {
  local name="${1:-}" target="${2:-}"
  [[ -n "$name" ]] || die "usage: vm umount <name> [target]   (omit target to unmount all)"
  exists "$name" || die "no such instance: $name"
  if [[ -n "$target" ]]; then
    multipass umount "$name:$target"
  else
    multipass umount "$name"
  fi
}

cmd_push() {
  local name="${1:-}" src="${2:-}" dest="${3:-/home/ubuntu}"
  [[ -n "$name" && -n "$src" ]] || die "usage: vm push <name> <host-path> [vm-dest]"
  [[ -e "$src" ]] || die "no such path: $src"
  exists "$name" || die "no such instance: $name"
  copy_into "$name" "$src" "$dest"
  echo "Pushed $src -> $name:$dest"
}

cmd_pull() {
  local name="${1:-}" src="${2:-}" dest="${3:-.}"
  [[ -n "$name" && -n "$src" ]] || die "usage: vm pull <name> <vm-path> [host-dest]"
  exists "$name" || die "no such instance: $name"
  [[ -d "$dest" ]] || die "not a directory: $dest"
  multipass transfer -r "$name:$src" "$dest" 2>/dev/null && {
    echo "Pulled $name:$src -> $dest"; return 0; }
  # Same broken-client fallback as copy_into, in the other direction.
  vm_exec "$name" tar -cf - -C "$(dirname "$src")" "$(basename "$src")" \
    | tar -xf - -C "$dest"
  echo "Pulled $name:$src -> $dest"
}

cmd_clone() {
  local src="${1:-}" new="${2:-}"
  [[ -n "$src" ]] || die "usage: vm clone <source> [new-name]"
  exists "$src" || die "no such instance: $src"

  local was; was="$(state_of "$src")"
  if [[ "$was" == "Running" ]]; then
    echo "Stopping '$src' (multipass can only clone a stopped instance)..."
    multipass stop "$src"
  fi

  # As in cmd_snap: a name collision must not leave the source stopped.
  local rc=0
  if [[ -n "$new" ]]; then
    multipass clone "$src" -n "$new" || rc=$?
  else
    multipass clone "$src" || rc=$?
  fi

  if [[ "$was" == "Running" ]]; then
    echo "Restarting '$src'..."
    multipass start "$src"
  fi
  [[ $rc -eq 0 ]] || die "clone of '$src' failed"
}

cmd_ip() {
  local name="${1:-$VM_DEFAULT_NAME}"
  exists "$name" || die "no such instance: $name"
  multipass info "$name" --format csv | awk -F, 'NR==2 {print $3}'
}

cmd_gui() {
  local app="/Library/Application Support/com.canonical.multipass/bin/Multipass.app"
  [[ -d "$app" ]] || die "Multipass.app not found (it ships with the Canonical .pkg, not the brew cask)."
  echo "Opening the multipass instance manager. Note: this manages VMs;"
  echo "it is not an Ubuntu desktop — the images are headless server images."
  open "$app"
}

need_multipass

[[ $# -eq 0 ]] && { show_help; exit 1; }

cmd="$1"; shift
case "$cmd" in
  new)            cmd_new "$@" ;;
  reset)          cmd_reset "$@" ;;
  nuke)           cmd_nuke "$@" ;;
  gc)             cmd_gc "$@" ;;
  sh|shell)       vm_connect "${1:-$VM_DEFAULT_NAME}" ;;
  run)            [[ $# -ge 2 ]] || die "usage: vm run <name> <cmd...>"
                  n="$1"; shift; vm_exec "$n" "$@" ;;
  ls|list)        cmd_ls ;;
  ip)             cmd_ip "$@" ;;
  mount)          cmd_mount "$@" ;;
  snap|snapshot)  cmd_snap "$@" ;;
  restore)        cmd_restore "$@" ;;
  stop)           passthru stop "$@" ;;
  start)          passthru start "$@" ;;
  restart)        cmd_restart "$@" ;;
  suspend)        passthru suspend "$@" ;;
  recover)        passthru recover "$@" ;;
  umount|unmount) cmd_umount "$@" ;;
  push)           cmd_push "$@" ;;
  pull)           cmd_pull "$@" ;;
  clone)          cmd_clone "$@" ;;
  bootstrap)      cmd_bootstrap "$@" ;;
  gui)            cmd_gui ;;
  -h|--help|help) show_help ;;
  *)              echo "vm: unknown command '$cmd'" >&2; echo >&2; show_help >&2; exit 1 ;;
esac
